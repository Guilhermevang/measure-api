# Chave da API do Google Gemini (obrigatório)
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Chave de autenticação da API (opcional — se não definida, a autenticação é desativada)
API_KEY=your_secret_key_here

# URL base da aplicação — usada para gerar URLs de imagens nas respostas
APP_BASE_URL=http://localhost:8800

# Porta do servidor (padrão: 8800)
PORT=8800

# Ambiente de execução
NODE_ENV=development

# Nível de log: trace | debug | info | warn | error
LOG_LEVEL=info
